# Normalizacion de fin de linea.
#
# Los dos trabajamos en Windows, pero los contenedores corren Linux. Un
# Dockerfile o un .sh con CRLF falla dentro del contenedor con errores que no
# mencionan el fin de linea. Estos archivos se guardan siempre con LF.

* text=auto

*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf
*.conf  text eol=lf

# Binarios: que Git no los toque.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.apk   binary
