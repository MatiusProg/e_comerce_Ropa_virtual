# FashionStore - variables de entorno del backend
#
# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio
# (esta en .gitignore). En Railway estos mismos nombres se cargan en
# Variables del servicio, no en un archivo.

# --- Aplicacion ----------------------------------------------------------
ENTORNO=desarrollo
DEBUG=true
API_PREFIX=/api/v1

# --- Base de datos -------------------------------------------------------
# La base vive en SUPABASE; Railway solo hospeda la API y la web.
#
# Local (docker compose):
DATABASE_URL=postgresql+psycopg://fashionstore:fashionstore@localhost:5432/fashionstore
#
# En Railway: copiar la cadena del SESSION POOLER de Supabase, no la conexion
# directa. Supabase > Project Settings > Database > Connection string >
# "Session pooler". Tiene esta forma:
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Dos motivos para el pooler y no la conexion directa:
#   1. La conexion directa (db.<ref>.supabase.co) es solo IPv6. Si el contenedor
#      no tiene salida IPv6, falla con un error de red que no menciona IPv6.
#   2. El pooler administra las conexiones; Supabase corta las directas cuando
#      se acumulan.
#
# Usar el puerto 5432 (session), NO el 6543 (transaction): psycopg 3 usa
# sentencias preparadas y el modo transaction las rompe.

# --- Datos iniciales (python -m app.db.seed) -----------------------------
ADMIN_EMAIL=admin@fashionstore.bo
# Sin valor por defecto a proposito: si no se define, el seed no crea el
# usuario en vez de crear uno con una contrasena conocida.
ADMIN_PASSWORD=

# --- Seguridad -----------------------------------------------------------
# Generar una clave nueva para produccion:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiar-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ----------------------------------------------------------------
# Separadas por coma. En produccion: la URL publica de la web en Railway.
# Mientras el dominio de la web no este aqui, la web carga bien y ninguna
# peticion funciona, y el error del navegador no menciona CORS con claridad.
CORS_ORIGINS=http://localhost:4200,http://localhost:8100

# --- Reservas ------------------------------------------------------------
RESERVA_VIGENCIA_HORAS=24

# --- Pasarela de pago (ciclo 3) ------------------------------------------
# Claves de PRUEBA de Stripe (empiezan con sk_test_ / whsec_).
# Nunca usar claves de produccion en este proyecto.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4200/pago/exito
STRIPE_CANCEL_URL=http://localhost:4200/pago/cancelado

# --- Inteligencia artificial (ciclo 3) -----------------------------------
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5
IA_MAX_PETICIONES_DIA=50

# --- Almacenamiento de imagenes ------------------------------------------
# En Railway debe coincidir con el punto de montaje del volumen.
MEDIA_ROOT=/app/media
MEDIA_URL=/media
